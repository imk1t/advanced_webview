<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.k1t.advanced_webview">
  <!-- Lets AdvancedSystemBrowser.isAvailable see whether an app can open https links (Android 11+). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>
  <application>
    <activity
      android:name=".InAppBrowserActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|locale"
      android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
  </application>
</manifest>
