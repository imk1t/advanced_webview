/build/
/coverage/

# APM (Agent Package Manager): downloaded packages and local verifier venv.
# Deployed skills (.agents/, .claude/skills/), MCP config (.mcp.json, .codex/)
# and apm.lock.yaml are committed so agents work on a fresh checkout.
apm_modules/
.venv-apm/
.claude/settings.local.json
