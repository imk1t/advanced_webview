# Supply-chain hardening. Bun reads only registry/auth keys from this file, so the same
# policy lives in bunfig.toml; this file covers npm, pnpm and tools that shell out to npm.

# Record exact versions instead of ^ / ~ ranges.
save-exact=true

# Never run dependency lifecycle scripts (the install-time vector used by Shai-Hulud-style worms).
ignore-scripts=true

# Do not install versions published less than 7 days ago (npm >= 11.10; days).
min-release-age=7

# Always write and honour the lockfile.
package-lock=true
