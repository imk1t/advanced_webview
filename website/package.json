{
  "name": "advanced-webview-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "check:mapping": "bun scripts/check-api-mapping.ts",
    "build": "bun run check:mapping && vitepress build",
    "preview": "vitepress preview",
