{
  "name": "advanced-webview-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "check:mapping": "bun scripts/check-api-mapping.ts",
    "build": "bun run check:mapping && vitepress build",
    "preview": "vitepress preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --ignore-pattern .vitepress/dist --ignore-pattern .vitepress/cache ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vitepress": "1.6.4"
  }
}
